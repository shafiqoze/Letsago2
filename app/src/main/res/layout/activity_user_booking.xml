<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:useDefaultMargins="true"
    android:alignmentMode="alignBounds"
    android:id="@+id/main"
    android:columnCount="2"
    android:padding="16dp"
    android:columnOrderPreserved="false"
    tools:context=".UserBookingActivity"
    android:background="@drawable/base">


    <TextView
        android:layout_columnSpan="2"
        android:layout_gravity="center_horizontal"
        android:text="Add New Booking"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginTop="30dp" />

    <TextView
        android:layout_columnSpan="2"
        android:layout_gravity="center"
        android:text="Enter booking information"
        android:textSize="16sp"
        android:textStyle="italic" />


    <TextView
        android:text="Pickup Date:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etPickupDate"
        android:layout_width="188dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:inputType="none"
        android:clickable="true"
        android:focusable="false"
        android:hint="YYYY-MM-DD"
        android:padding="8dp" />

    <Button
        android:layout_columnSpan="2"
        android:id="@+id/btnPickupDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick Date"
        android:onClick="showDatePickerDialog"
        android:tag="pickup_date"
        android:textColor="@android:color/white"
        android:backgroundTint="@color/black"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:text="Return Date:"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etReturnDate"
        android:layout_width="188dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:inputType="none"
        android:clickable="true"
        android:focusable="false"
        android:hint="YYYY-MM-DD"
        android:padding="8dp" />

    <Button
        android:layout_columnSpan="2"
        android:id="@+id/btnReturnDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Pick Date"
        android:onClick="showDatePickerDialog"
        android:tag="return_date"
        android:textColor="@android:color/white"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/black"/>

    <Button
        android:id="@+id/btnSubmitBooking"
        android:layout_columnSpan="2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:onClick="addNewBooking"
        android:textColor="@android:color/white"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:backgroundTint="#9C0B0B"/>
</GridLayout>
