<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
         />
    <!--android:src="@drawable/bgnew"-->

    <Button
        android:id="@+id/btnBookCar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book a Car"
        android:onClick="onBookCarClicked"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="450dp"/>

    <Button
        android:id="@+id/btnCheckStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Check Booking Status"
        android:onClick="onCheckStatusClicked"
        android:layout_below="@id/btnBookCar"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:onClick="onLogoutClicked"
        android:layout_below="@id/btnCheckStatus"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>
</RelativeLayout>
