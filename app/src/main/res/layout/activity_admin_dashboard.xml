<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background Image -->
    <ImageView
        android:id="@+id/background_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
         />
    <!--android:src="@drawable/bgnew"-->

    <Button
        android:id="@+id/buttonAddCar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="450dp"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:text="Add Car"
        android:onClick="onAddCarClicked" />

    <Button
        android:id="@+id/buttonViewBookings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonAddCar"
        android:layout_margin="16dp"
        android:text="View Bookings"
        android:layout_centerHorizontal="true"
        android:onClick="onViewBookingsClicked" />

    <Button
        android:id="@+id/buttonLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/buttonViewBookings"
        android:layout_margin="16dp"
        android:text="Logout"
        android:layout_centerHorizontal="true"
        android:onClick="onLogoutClicked" />
</RelativeLayout>
